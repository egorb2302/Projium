{
  "name": "projium",
  "version": "0.9.0",
  "description": "Local dashboard over Markdown project cards: stages, tasks, audits, uptime and build time from Claude Code transcripts",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "bin": { "projium": "bin/projium.mjs" },
  "scripts": {
    "start": "node --no-warnings server.mjs",
    "setup": "node --no-warnings bin/projium.mjs setup",
    "start:bg": "node --no-warnings scripts/start-bg.mjs",
    "stop": "node --no-warnings scripts/stop.mjs",
    "doctor": "node --no-warnings scripts/doctor.mjs",
    "init": "node --no-warnings scripts/init.mjs",
    "survey": "node --no-warnings scripts/survey.mjs",
    "mcp": "node --no-warnings scripts/mcp.mjs",
    "autostart": "node --no-warnings scripts/autostart.mjs",
    "test": "node --no-warnings --test --test-timeout=30000 \"test/*.test.mjs\""
  }
}
